# Copiar a .env.local y completar con las claves del proyecto de Supabase
# (Settings → API en el panel de Supabase).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Se salta RLS por completo. Nunca exponer al navegador ni commitear.
SUPABASE_SERVICE_ROLE_KEY=

# La base para armar el enlace de seguimiento que se imprime en el
# comprobante y en la etiqueta (/seguimiento/<token>). En local:
# http://localhost:3000
NEXT_PUBLIC_APP_URL=

# Correo transaccional (resend.com, capa gratuita 3000/mes). Sin esto,
# lib/mensajeria/correo.ts no envía y solo deja un log -- no rompe nada.
RESEND_API_KEY=
RESEND_FROM=

# WhatsApp Business Platform (Cloud API de Meta) -- pendiente de decisión
# de negocio: crear la cuenta en business.facebook.com, verificar el
# negocio y sacar un número (no necesita tener WhatsApp instalado en
# ningún celular). Hasta que estas dos existan, lib/mensajeria/whatsapp.ts
# solo deja un log, igual que el correo sin configurar.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Segundo número, para cuando el equipo recibido es un celular sin
# WhatsApp propio disponible -- mismo negocio de Meta, otro phone_number_id.
WHATSAPP_PHONE_ID_SECUNDARIO=
